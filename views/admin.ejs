<%- include('partials/header') %>
<h2>Editor Artikel Markdown</h2>
<form action="/admin/save" method="POST">
    <input type="text" name="title" placeholder="Judul" required>
    <input type="text" name="slug" placeholder="slug-file (tanpa spasi)" required>
    <input type="text" name="category" placeholder="Kategori" required>
    <textarea name="content" placeholder="Isi Markdown..." required></textarea>
    <button type="submit">Simpan Artikel</button>
</form>
<%- include('partials/footer') %>